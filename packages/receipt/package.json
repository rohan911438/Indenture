{
  "name": "@indenture/receipt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The receipt seam: EIP-712 Receipt struct, byte-identical to contracts/src/libs/ReceiptLib.sol",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "vector": "tsx src/vector.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "viem": "^2.21.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
}
