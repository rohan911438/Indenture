# ---------------------------------------------------------------------------
# Indenture environment. Copy to .env for local dev. NEVER commit .env.
# deployments.json is the source of truth for addresses/topics, NOT env vars.
# ---------------------------------------------------------------------------

# --- Chain (public, safe) ---
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_MIRROR_URL=https://testnet.mirrornode.hedera.com/api/v1
CHAIN_ID=296

# --- HEDERA_OPERATOR: testnet only, GitHub secret. Pays for HCS submits. ---
HEDERA_OPERATOR_ID=0.0.xxxxxx
HEDERA_OPERATOR_KEY=302e...

# --- ISSUER_KEY: offline laptop ONLY. Never in CI. Signs the mandate. ---
ISSUER_KEY=0x...

# --- MANAGER_KEY: GitHub secret. Low blast radius BY DESIGN - assume stolen. ---
MANAGER_KEY=0x...

# --- VALIDATOR_KEY: Wrangler secret only. HIGH blast radius. Never here in prod. ---
VALIDATOR_KEY=0x...

# --- LLM_API_KEY: free tier, no blast radius. ---
LLM_API_KEY=
PROPOSER=RuleProposer   # RuleProposer | LlmProposer

# --- Service URLs (filled after deploy) ---
VALIDATOR_URL=http://localhost:8787
