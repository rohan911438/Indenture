.DS_Store
*.log
coverage/

# tsc incremental cache
*.tsbuildinfo
contracts/deployments.local.json
contracts/mandate.compiled.json

# working docs (RESEARCH.md / PLAN.md / TRACKS.md) - local only
# NOTE: docs/PLAN.md and docs/RESEARCH.md were already committed before this
# rule existed, so git keeps tracking them. To actually untrack:
#   git rm -r --cached docs && git commit -m "chore: untrack docs/"
docs/

# working notes for the repo owner - local only
memory.md
report.md
